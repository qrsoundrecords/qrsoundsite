# Environment variables for the demo submission endpoint (see README → Email setup)

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where demo submissions are delivered (label inbox)
CONTACT_EMAIL=qrsoundrecords@gmail.com

# Verified "from" address on Resend, e.g. "QR Sound Records <demos@yourdomain.com>"
FROM_EMAIL=
